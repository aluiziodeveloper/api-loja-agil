{
  "name": "api-loja-agil",
  "version": "0.0.1",
  "description": "API da Loja Ágil: pedidos e estoque com NestJS, DDD, Clean Architecture e TDD",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write .",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware --deny-warnings src/ test/ katas/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts --coverage",
    "test:int": "vitest run --config ./vitest.config.int.ts --coverage",
    "format:check": "prettier --check .",
    "lint:fix": "oxlint --type-aware --fix src/ test/ katas/",
    "typecheck": "tsc --noEmit",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "operator:promote": "node dist/cli/promote-operator.js",
    "db:seed": "node dist/cli/seed.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-fastify": "^12.4.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "typescript": "~6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
