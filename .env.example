NODE_ENV=development
PORT=3000
# No Docker, o compose.yaml já define as duas URLs apontando para o serviço "db".
# Fora dele, use localhost:
# DATABASE_URL=postgresql://postgres:docker@localhost:5432/loja_agil?schema=public
# DATABASE_URL_TEST=postgresql://postgres:docker@localhost:5432/loja_agil_test?schema=public
# JWT_SECRET=<pelo menos 32 caracteres; gere com: openssl rand -base64 48>
# JWT_EXPIRES_IN_SECONDS=3600
# LOG_LEVEL=info  (fatal, error, warn, info, debug, trace ou silent)
